## Copy this file to db_credentials.env, fill in real values, then upload
## db_credentials.env into the Jupyter session next to the notebooks.
## db_credentials.env is git-ignored -- never commit real credentials.
db_host=db.nids.caida.org
db_port=
db_name=

## ITDK_READ_DSN is read-only (used by nids-itdk-key.ipynb and
## nids-table-csv.ipynb). This is the one to hand out to students.
db_read_user=
db_read_password=
ITDK_READ_DSN=postgresql://${db_read_user}:${db_read_password}@${db_host}:${db_port}/${db_name}